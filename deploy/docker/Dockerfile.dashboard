# ==============================================================================
# Enterprise Attendance Integration Platform - Dashboard Dockerfile
# ==============================================================================

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @attendance/dashboard build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache dumb-init

USER node
ENV NODE_ENV=production
ENV PORT=3001

COPY --chown=node:node --from=builder /app/package.json ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/apps/dashboard ./apps/dashboard
COPY --chown=node:node --from=builder /app/packages ./packages

EXPOSE 3001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node_modules/.bin/next", "start", "apps/dashboard", "-p", "3001"]
