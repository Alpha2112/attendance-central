  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Biometric Punch Ingestion & Normalization Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(attendance_raw_events_received_total[1m])",
          "legendFormat": "Raw Events Ingested / sec",
          "refId": "A"
        },
        {
          "expr": "rate(attendance_events_normalized_total[1m])",
          "legendFormat": "Normalized Events / sec",
          "refId": "B"
        },
        {
          "expr": "rate(attendance_events_duplicate_total[1m])",
          "legendFormat": "Duplicates Filtered / sec",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Outbound Webhook Delivery Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(attendance_webhook_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p50 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(attendance_webhook_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95 Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(attendance_webhook_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Terminal Fleet Online Ratio by Vendor",
      "type": "piechart",
      "targets": [
        {
          "expr": "count(attendance_device_status{status=\"ONLINE\"}) by (vendor)",
          "legendFormat": "{{vendor}} Online",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Transactional Outbox Backlog",
      "type": "stat",
      "targets": [
        {
          "expr": "attendance_outbox_pending_count",
          "legendFormat": "Pending Outbox Envelopes",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Kafka Consumer Lag (attendance.raw.v1)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{topic=\"attendance.raw.v1\"})",
          "legendFormat": "Total Partition Lag",
          "refId": "A"
        }
      ]
    }
  ],
