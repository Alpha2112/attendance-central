{
  "name": "@attendance/api",
  "version": "1.0.0",
  "description": "Enterprise Attendance Integration Platform - Central API Gateway & Control Plane",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@attendance/config": "workspace:*",
    "@attendance/contracts": "workspace:*",
    "@attendance/database": "workspace:*",
    "@attendance/integration": "workspace:*",
    "@attendance/logging": "workspace:*",
    "@attendance/observability": "workspace:*",
    "@attendance/kafka": "workspace:*",
    "@attendance/redis": "workspace:*",
    "@attendance/adapter-hikvision": "workspace:*",
    "@attendance/adapter-zkteco": "workspace:*",
    "@attendance/adapter-suprema": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-fastify": "^11.0.10",
    "@nestjs/swagger": "^11.0.4",
    "fastify": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
