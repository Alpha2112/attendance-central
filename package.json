{
  "name": "enterprise-attendance-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Attendance Device Integration Platform Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @attendance/api dev",
    "dev:dashboard": "pnpm --filter @attendance/dashboard dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "vitest --ui",
    "test:cov": "turbo run test -- --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "migrate:up": "pnpm --filter @attendance/database migrate:up",
    "migrate:status": "pnpm --filter @attendance/database migrate:status",
    "seed": "pnpm --filter @attendance/database seed",
    "sim:single": "pnpm --filter @attendance/simulator sim single",
    "sim:duplicates": "pnpm --filter @attendance/simulator sim duplicates",
    "sim:offline": "pnpm --filter @attendance/simulator sim offline",
    "sim:batch": "pnpm --filter @attendance/simulator sim batch",
    "collector:test-conn": "pnpm --filter @attendance/collector exec tsx src/cli.ts test-connection",
    "collector:sync-once": "pnpm --filter @attendance/collector exec tsx src/cli.ts sync-once",
    "collector:start": "pnpm --filter @attendance/collector exec tsx src/cli.ts run",
    "hikvision:test-conn": "pnpm --filter @attendance/adapter-hikvision exec tsx src/cli.ts test-conn",
    "hikvision:device-info": "pnpm --filter @attendance/adapter-hikvision exec tsx src/cli.ts device-info",
    "hikvision:sync-once": "pnpm --filter @attendance/adapter-hikvision exec tsx src/cli.ts sync-once",
    "suprema:test-conn": "pnpm --filter @attendance/adapter-suprema exec tsx src/cli.ts test-conn",
    "suprema:device-info": "pnpm --filter @attendance/adapter-suprema exec tsx src/cli.ts device-info",
    "suprema:sync-once": "pnpm --filter @attendance/adapter-suprema exec tsx src/cli.ts sync-once",
    "suprema:listen-realtime": "pnpm --filter @attendance/adapter-suprema exec tsx src/cli.ts listen-realtime",
    "normalizer:sample": "pnpm --filter @attendance/integration exec tsx src/cli.ts normalize-sample",
    "outbox:process-once": "pnpm --filter @attendance/integration exec tsx src/cli.ts process-outbox",
    "integration:test-webhook": "pnpm --filter @attendance/integration exec tsx src/cli.ts test-webhook",
    "integration:replay": "pnpm --filter @attendance/integration exec tsx src/cli.ts replay",
    "test:chaos": "pnpm --filter @attendance/qa-engine test:chaos",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@vitest/ui": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
