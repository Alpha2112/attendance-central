{
  "name": "@attendance/database",
  "version": "1.0.0",
  "description": "Enterprise Attendance Integration Platform - Database Connectivity & Health Abstraction",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "migrate:up": "tsx src/cli.ts up",
    "migrate:status": "tsx src/cli.ts status",
    "seed": "tsx src/cli.ts seed",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@attendance/config": "workspace:*",
    "@attendance/logging": "workspace:*",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
