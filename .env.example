# ==============================================================================
# Enterprise Attendance Platform - Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Service Identifiers
SERVICE_NAME=attendance-api
SERVICE_VERSION=1.0.0

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:4000
API_GLOBAL_PREFIX=api/v1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=attendance_user
DB_PASSWORD=attendance_pass
DB_DATABASE=attendance_db
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=7379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=att:
REDIS_CONNECT_TIMEOUT_MS=10000

# Apache Kafka Configuration
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=attendance-platform-dev
KAFKA_GROUP_ID=attendance-normalizer-group
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000

# Next.js Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Suprema G-SDK: terminals have no HTTP API. The collector is a gRPC client of a
# Suprema Device Gateway, which connects to the terminal over TCP (51211 / 51213 SSL).
# BioStar 2 is NOT required.
# Host 14000 maps to the gateway container's :4000 (the API already uses host :4000).
# When the collector runs inside Docker, use suprema-gateway:4000 instead.
SUPREMA_GATEWAY_ADDR=127.0.0.1:14000
# Path to the gateway's CA certificate (generated by the gateway on first start).
# Leave empty to use an insecure channel (local development only).
SUPREMA_GATEWAY_CA_CERT=./deploy/suprema-gateway/cert/ca.crt
# Directory containing the licensed G-SDK .proto files (from the Client SDK).
SUPREMA_GSDK_PROTO_DIR=./vendor/suprema-gsdk/proto
# Official G-SDK event-code catalog (used to label verification types).
SUPREMA_GSDK_EVENT_CODE_FILE=./vendor/suprema-gsdk/event_code.json
# CLI test target (used by `pnpm suprema:*` scripts).
SUPREMA_DEVICE_IP=192.168.1.3
SUPREMA_DEVICE_PORT=51211
SUPREMA_DEVICE_SSL=false
